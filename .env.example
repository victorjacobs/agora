# Local laptop mode: remote Hermes endpoint, no CORS or reverse-proxy changes needed.
HERMES_ENDPOINT=https://hermes.example.com
# Omit to use the server's launch profile.
VITE_HERMES_PROFILE=
# Used only when HERMES_ENDPOINT is omitted (same-origin development).
# HERMES_TARGET=http://127.0.0.1:8080

# Production behind an HTTPS reverse proxy: requires a Hermes callback allowlist patch.
# Keep unset for laptop development.
# AGORA_PUBLIC_ORIGIN=https://agora.example.com
